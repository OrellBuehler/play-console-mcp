# Google Play service account key (Play Console -> Setup -> API access)
# Provide the downloaded JSON key either as a path ...
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

# ... or inline as the raw JSON:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Optional: default app to operate on, so tools can omit package_name
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
